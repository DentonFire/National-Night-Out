rules_version = '2';

// National Night Out map.
//   Read:  any signed-in, email-verified @cityofdenton.com account.
//   Write: accounts listed in /roles/{email} as "command" or "owner".
//   Roles: only an "owner" can grant or remove Command access.
// The page checks the email domain too, but these rules are the real gate: anyone can create a
// Firebase Auth account through the API, bypassing the page.

service cloud.firestore {
  match /databases/{database}/documents {

    function cityUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@cityofdenton[.]com$');
    }
    function roleDoc() {
      return /databases/$(database)/documents/roles/$(request.auth.token.email.lower());
    }
    function role() {
      return exists(roleDoc()) ? get(roleDoc()).data.role : 'crew';
    }
    function isCommand() { return cityUser() && role() in ['command', 'owner']; }
    // Finalized = locked: party changes are refused until Command unlocks (config/event).
    function locked() {
      return exists(/databases/$(database)/documents/config/event)
        && get(/databases/$(database)/documents/config/event).data.finalized == true;
    }
    function isOwner()   { return cityUser() && role() == 'owner'; }

    match /parties/{partyId} {
      allow read: if cityUser();
      allow create, update: if isCommand() && !locked()
        && request.resource.data.name is string
        && request.resource.data.units is list
        && request.resource.data.units.size() <= 40
        && !('host' in request.resource.data)
        && !('hostName' in request.resource.data);
      allow delete: if isCommand() && !locked();
    }

    match /config/event {
      allow read: if cityUser();
      allow write: if isCommand()
        && request.resource.data.finalized is bool
        && request.resource.data.acceptedIssues is list;
    }

    match /roles/{email} {
      allow read: if cityUser() && (email == request.auth.token.email.lower() || isOwner());
      allow create, update: if isOwner()
        && email.matches('.*@cityofdenton[.]com$')
        && request.resource.data.role in ['command', 'owner'];
      allow delete: if isOwner() && email != request.auth.token.email.lower();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
